{
  "manifest_version": 3,
  "name": "GEO Page Audit",
  "version": "0.2.0",
  "description": "GEO page audit: SEO basics, LLM readability and structured data. Optional AI crawler check (GPTBot, ClaudeBot, PerplexityBot) via datadetective.app.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
