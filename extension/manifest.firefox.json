{
  "manifest_version": 3,
  "name": "GEO Page Audit",
  "version": "0.2.0",
  "description": "GEO page audit: SEO basics, LLM readability and structured data. Optional AI crawler check (GPTBot, ClaudeBot, PerplexityBot) via datadetective.app.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js",
    "preferred_environment": [
      "document",
      "service_worker"
    ],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "geo-page-audit@georgsimic.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "browsingActivity"
        ]
      }
    }
  }
}
